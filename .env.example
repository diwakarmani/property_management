# PropertyApp — Expo client env vars.
# Copy to `.env` (already gitignored) and fill in for local development.
# Expo statically inlines every EXPO_PUBLIC_* var at bundle time; restart the
# Metro dev server after changing this file for the new value to take effect.

# Backend API base URL. Pick the one that matches how you're running the app:
#  - iOS simulator + backend on your Mac:  http://localhost:8080
#  - Physical iOS device on Wi-Fi:         http://<your-mac-LAN-ip>:8080
#  - Android phone (USB) or emulator, backend on your Mac: keep http://localhost:8080
#    and run `adb reverse tcp:8080 tcp:8080` + `adb reverse tcp:8081 tcp:8081` so the
#    device's localhost reaches your Mac. (An emulator can also use http://10.0.2.2:8080.)
#  - Android phone on Wi-Fi without USB:   http://<your-mac-LAN-ip>:8080
#  - Hitting deployed prod from a dev build: https://champions-3qkd.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Axios request timeout in ms (cold-start friendly default is 30s).
EXPO_PUBLIC_API_TIMEOUT=30000
